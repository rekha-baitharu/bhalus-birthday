{% comment %}
  Section: password-birthday-content.liquid
  Romantic Birthday Cover and Entry for Password-Protected Storefront
{% endcomment %}

<div class="password-birthday-hero">
  <div class="password-hero-card">
    <div class="birthday-crown" aria-hidden="true">👑</div>
    <span class="password-badge">{{ section.settings.badge_text }}</span>

    <h1 class="password-hero-heading">{{ section.settings.heading }}</h1>

    <div class="welcome-divider" aria-hidden="true">
      <span class="flourish">❦</span>
    </div>

    <div class="birthday-cake-animation" aria-hidden="true">
      <div class="candle">
        <div class="flame"></div>
      </div>
      <div class="cake-top"></div>
      <div class="cake-bottom"></div>
    </div>

    <div class="password-hero-message">
      {{ section.settings.message }}
    </div>

    <div class="password-hero-actions">
      <button type="button" class="btn-love-primary pulse-subtle" onclick="document.getElementById('OpenPasswordModalBtn').click();">
        <span>{{ section.settings.button_text }}</span>
      </button>
    </div>

    <div class="password-hint-box">
      <span class="hint-icon" aria-hidden="true">💡</span>
      <span class="hint-text">{{ section.settings.hint_text }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Birthday Password Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "19 October • Private Love Story Gift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Happy Birthday, My Love ❤️"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Welcome Message",
      "default": "<p>A special 29-chapter love book and memories universe created just for you. Enter your secret passcode to step inside our story.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Enter Our Universe 💌"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint Text",
      "default": "A birthday surprise made exclusively for my favourite person."
    }
  ]
}
{% endschema %}
