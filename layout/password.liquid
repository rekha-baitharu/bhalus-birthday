<!doctype html>
<html class="no-js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FFF9F4">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Caveat:wght@400;600;700&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} • 19 October Birthday Surprise</title>

    <meta name="description" content="{{ page_description | default: 'A special birthday love story website' | escape }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'love-story.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'password-birthday.css' | asset_url }}">

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'password-modal.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="password-birthday-body">
    <!-- Subtle Ambient Glow Particles -->
    <div class="love-ambient-bg" aria-hidden="true">
      <div class="ambient-orb ambient-orb-1"></div>
      <div class="ambient-orb ambient-orb-2"></div>
      <div class="ambient-orb ambient-orb-3"></div>
      <div class="ambient-hearts" id="AmbientHearts"></div>
    </div>

    <header class="password-romantic-topbar">
      <div class="password-topbar-inner">
        <span class="password-brand-pill">
          <span class="pill-sparkle" aria-hidden="true">🎂</span>
          <span>19 October • Birthday Edition</span>
        </span>
        <button type="button" class="password-open-modal-btn" id="OpenPasswordModalBtn" aria-label="Enter Passcode">
          <span aria-hidden="true">🔒</span>
          <span>Unlock With Passcode</span>
        </button>
      </div>
    </header>

    <main id="MainContent" class="password-birthday-main">
      {{ content_for_layout }}
    </main>

    <footer class="password-romantic-footer">
      <p class="footer-heart-msg">Made with all my heart for your birthday • 19 October ❤️</p>
    </footer>

    <!-- Passcode Modal Dialog -->
    <div class="password-gate-modal" id="PasswordGateModal" role="dialog" aria-modal="true" aria-hidden="true" style="display: none;">
      <div class="password-modal-backdrop" id="PasswordModalBackdrop"></div>
      <div class="password-gate-card">
        <button type="button" class="password-gate-close" id="ClosePasswordModalBtn" aria-label="Close passcode dialog">✕</button>
        <div class="gate-icon" aria-hidden="true">💌</div>
        <h3 class="gate-title">Enter Secret Key</h3>
        <p class="gate-sub">Enter the passcode to enter our private love story book.</p>

        {%- form 'storefront_password', class: 'romantic-storefront-form' -%}
          <div class="gate-input-wrapper">
            <input
              type="password"
              name="password"
              id="StorefrontPassword"
              class="romantic-gate-input"
              autocomplete="current-password"
              placeholder="Your Secret Key..."
              required
              autofocus
            >
          </div>
          {%- if form.errors -%}
            <p class="gate-error-msg" role="alert">
              <span>Incorrect passcode. Please try again with love ❤️</span>
            </p>
          {%- endif -%}
          <button type="submit" name="commit" class="btn-love-primary gate-submit-btn">
            <span>Unlock My Heart ❤️</span>
          </button>
        {%- endform -%}

        <div class="gate-admin-box">
          <small class="admin-link">{{ 'general.password_page.admin_link_html' | t }}</small>
        </div>
      </div>
    </div>

    <script>
      (function() {
        const modal = document.getElementById('PasswordGateModal');
        const openBtn = document.getElementById('OpenPasswordModalBtn');
        const closeBtn = document.getElementById('ClosePasswordModalBtn');
        const backdrop = document.getElementById('PasswordModalBackdrop');

        function openModal() {
          if (!modal) return;
          modal.style.display = 'flex';
          modal.setAttribute('aria-hidden', 'false');
          const input = document.getElementById('StorefrontPassword');
          if (input) input.focus();
        }

        function closeModal() {
          if (!modal) return;
          modal.style.display = 'none';
          modal.setAttribute('aria-hidden', 'true');
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', closeModal);

        // Auto open if form had errors
        {%- if form.errors -%}
          openModal();
        {%- endif -%}

        // Listen for keyboard escape
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') closeModal();
        });

        // Ambient floating particles
        const container = document.getElementById('AmbientHearts');
        if (container && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const symbols = ['❤️', '🎂', '✨', '🌸', '❦'];
          setInterval(() => {
            if (document.hidden) return;
            const h = document.createElement('span');
            h.className = 'floating-heart';
            h.textContent = symbols[Math.floor(Math.random() * symbols.length)];
            h.style.left = (Math.random() * 92 + 4) + 'vw';
            h.style.animationDuration = (Math.random() * 8 + 14) + 's';
            h.style.fontSize = (Math.random() * 10 + 12) + 'px';
            container.appendChild(h);
            setTimeout(() => h.remove(), 22000);
          }, 3200);
        }
      })();
    </script>
  </body>
</html>
